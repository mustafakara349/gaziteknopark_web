# .env dosyası Git'e commit edilmez, bu şablon (.env.example) edilir.
# ============================================================

# Backend API base URL
# Geliştirme: http://localhost:5080/api
# Üretim: https://api.gaziteknopark.com.tr/api
VITE_API_BASE_URL=http://localhost:5080/api

# Google reCAPTCHA v2 Site Key
# Geliştirme/test: Google test key (6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI)
# Üretim: Google Console'dan alınan gerçek site key
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
